---
import { Picture } from 'astro:assets';
import { imageFor } from '../lib/images';
interface Props { src: string; alt: string; hero?: boolean; class?: string; position?: string; }
const { src, alt, hero = false, class: className = '', position = 'center' } = Astro.props;
const photo = await imageFor(src);
const widths = [...new Set([480, 800, 1200, 1800, 2400].filter(w => w < photo.width).concat(Math.min(photo.width, 2400)))];
---
<Picture src={photo} alt={alt} formats={['avif', 'webp']} fallbackFormat="jpg"
  widths={widths} width={Math.min(photo.width, 2400)} sizes={hero ? '100vw' : '(min-width: 900px) 50vw, 100vw'}
  loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} decoding="async"
  class={className} style={'object-position:' + position} quality={80} />
