---
import Site from '../../layouts/Site.astro';
import Photo from '../../components/Photo.astro';
import Placeholder from '../../components/Placeholder.astro';
import Projects from '../../components/Projects.astro';
import Video from '../../components/Video.astro';
import { loadContent } from '../../lib/content.mjs';
import { allRoutes, route, copy } from '../../lib/routes.mjs';
export function getStaticPaths() {
  return allRoutes().map(({ lang, page, slug }) => ({ params: { lang, slug: slug || undefined }, props: { lang, page } }));
}
const { lang, page } = Astro.props as { lang: 'fr' | 'en'; page: string };
const data = await loadContent();
const { profile, projects } = data;
const content = profile[lang];
const t = copy[lang];
const modelling = projects.filter(p => p.category !== 'film');
const films = projects.filter(p => p.category === 'film');
const paragraphs = (value: string) => value.split(/\n\s*\n/).filter(Boolean);
---
<Site lang={lang} page={page} data={data}>
  {page === 'home' && <>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-media">
        {profile.hero ? <Photo src={profile.hero} alt={content.heroAlt} hero position={profile.heroPosition} /> : <Placeholder label={t.photoPending} wide />}
      </div>
      <div class="hero-content"><p class="eyebrow">{content.title}</p><h1 id="hero-title">{profile.name}</h1><a href={route(lang, 'portfolio')} class="hero-link">{t.discover}<span aria-hidden="true">↗</span></a></div>
      <a class="scroll-cue" href="#introduction"><span>{t.scroll}</span><span aria-hidden="true">↓</span></a>
    </section>
    <section class="intro section-shell" id="introduction">
      <p class="eyebrow">{profile.name} / {content.title}</p>
      <div><h2>{content.intro || (lang === 'fr' ? 'L’image. Le mouvement. L’émotion.' : 'Image. Movement. Emotion.')}</h2>
        {content.biography ? <p>{paragraphs(content.biography)[0]}</p> : <p class="draft-copy">{t.bioPending}</p>}
        <a class="text-link" href={route(lang, 'about')}>{t.more}<span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="section-shell home-selection"><div class="section-heading"><div><p class="eyebrow">01 / {t.selection}</p><h2>{t.selectedWork}</h2></div><a class="text-link" href={route(lang, 'portfolio')}>{t.viewAll} ↗</a></div>
      {modelling.length ? <Projects projects={modelling.slice(0, 2)} lang={lang} /> : <div class="empty-book"><Placeholder label={t.photoPending} /><div><p class="eyebrow">{t.portfolio}</p><p>{t.portfolioPending}</p></div></div>}
    </section>
    <section class="acting-feature section-shell"><div><p class="eyebrow">02 / {t.acting}</p><h2>{lang === 'fr' ? 'À l’écran.' : 'On screen.'}</h2>{content.acting && <p>{paragraphs(content.acting)[0]}</p>}<a class="text-link" href={route(lang, 'acting')}>{t.acting} ↗</a></div>
      {profile.showreel ? <Video url={profile.showreel} lang={lang} poster={profile.hero} posterAlt={content.heroAlt} /> : <div class="reel-empty"><span aria-hidden="true">▶</span><p>{t.actingPending}</p></div>}
    </section>
  </>}
  {page === 'about' && <section class="section-shell about-page">
    <div class="about-photo">{profile.portrait ? <Photo src={profile.portrait} alt={content.portraitAlt} /> : <Placeholder label={t.photoPending} />}</div>
    <div class="about-copy"><p class="eyebrow">{t.about}</p><h1>{profile.name}</h1><p class="role-label">{content.title}{profile.location && ' · ' + profile.location}</p>
      {content.biography ? paragraphs(content.biography).map(p => <p>{p}</p>) : <p class="draft-copy">{t.bioPending}</p>}
      {!!profile.details.length && <div class="professional-details"><h2>{t.details}</h2><dl>{profile.details.map(d => <div><dt>{d.label[lang]}</dt><dd>{d.value}</dd></div>)}</dl></div>}
      {!!profile.agencies.length && <div class="agency-list"><h2>{t.representation}</h2>{profile.agencies.map(a => <p><span>{a.territory}</span>{a.url ? <a href={a.url} rel="noopener noreferrer" target="_blank">{a.name} ↗</a> : a.name}</p>)}</div>}
      <a class="text-link" href={route(lang, 'contact')}>{t.contact} ↗</a>
    </div>
  </section>}
  {page === 'portfolio' && <section class="section-shell portfolio-page">
    <header class="page-heading"><p class="eyebrow">{content.title}</p><h1>{t.selectedWork}</h1><p>{t.portfolio}</p></header>
    {!!modelling.length && <div class="gallery-filters" aria-label={lang === 'fr' ? 'Filtrer les projets' : 'Filter projects'} hidden>{['all', ...new Set(modelling.map(p => p.category))].map((cat, i) => <button type="button" data-filter={cat} aria-pressed={i === 0 ? 'true' : 'false'}>{(t as Record<string, string>)[cat]}</button>)}</div>}
    {modelling.length ? <Projects projects={modelling} lang={lang} /> : <div class="empty-book"><Placeholder label={t.photoPending} /><p>{t.portfolioPending}</p></div>}
  </section>}
  {page === 'acting' && <section class="section-shell acting-page">
    <header class="page-heading"><p class="eyebrow">{profile.name}</p><h1>{t.acting}</h1></header>
    {content.acting ? <div class="text-column">{paragraphs(content.acting).map(p => <p>{p}</p>)}</div> : <p class="draft-copy">{t.actingPending}</p>}
    {profile.showreel && <Video url={profile.showreel} lang={lang} poster={profile.hero} posterAlt={content.heroAlt} />}
    {!!films.length && <Projects projects={films} lang={lang} />}
  </section>}
  {page === 'contact' && <section class="section-shell contact-page"><p class="eyebrow">{t.inquiries}</p><h1>{t.connect}</h1>
    {profile.email ? <a class="contact-email" href={'mailto:' + profile.email}>{profile.email}<span aria-hidden="true">↗</span></a> : <p class="draft-copy">{t.contactPending}</p>}
    {profile.location && <p>{profile.location}</p>}
    {!!profile.agencies.length && <div class="agency-list"><h2>{t.representation}</h2>{profile.agencies.map(a => <p><span>{a.territory}</span>{a.url ? <a href={a.url} rel="noopener noreferrer" target="_blank">{a.name} ↗</a> : a.name}</p>)}</div>}
    <div class="social-links">{profile.socials.map(s => <a href={s.url} rel="noopener noreferrer" target="_blank">{s.label} ↗</a>)}</div>
  </section>}
  {page === 'legal' && <section class="section-shell legal-page"><p class="eyebrow">{profile.name}</p><h1>{t.legal}</h1><div class="text-column">{profile.legal[lang] ? paragraphs(profile.legal[lang]).map(p => <p>{p}</p>) : <p>{t.copyPending}</p>}</div></section>}
  {['home', 'about', 'portfolio', 'acting'].includes(page) && <section class="contact-strip section-shell"><div><p class="eyebrow">{t.inquiries}</p><h2>{t.connect}</h2></div><a href={route(lang, 'contact')} aria-label={t.contact} class="circle-link">↗</a></section>}
</Site>
