{
  "name": "nour-salem-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4381",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:production": "node scripts/test-production-build.mjs",
    "build": "node scripts/validate-content.mjs && astro build && node scripts/finalize-build.mjs",
    "build:release": "node scripts/release-build.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4381",
    "verify:dist": "node scripts/verify-dist.mjs",
    "deploy": "npm run build:release && wrangler deploy --env production",
    "prepare:photo": "node scripts/prepare-photo.mjs"
  },
  "dependencies": {
    "astro": "7.4.5",
    "sharp": "0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "lighthouse": "13.6.0",
    "typescript": "^5.9.3",
    "wrangler": "4.157.0",
    "yaml": "^2.8.1"
  }
}
