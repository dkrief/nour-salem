{
  "description": "Redirect www to the canonical portfolio domain",
  "expression": "http.host eq \"www.nour-salem.com\"",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": { "expression": "concat(\"https://nour-salem.com\", http.request.uri.path)" },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
